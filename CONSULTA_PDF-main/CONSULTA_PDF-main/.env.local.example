# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio — https://aistudio.google.com/apikey
# GOOGLE_AI_API_KEY_2, _3, _4, ... son opcionales: si se agota la cuota
# de una, el backend rota automáticamente a la siguiente (numeradas en
# secuencia, sin límite -- ver src/lib/ai/gemini.ts).
GOOGLE_AI_API_KEY=
GOOGLE_AI_API_KEY_2=
GOOGLE_AI_API_KEY_3=
GOOGLE_AI_API_KEY_4=

# Nombres de modelo Gemini — se ajustan aquí sin tocar código de negocio.
# Usa siempre un alias/versión estable (nunca "-latest", son experimentales
# y con rate limits restrictivos). Revisa https://ai.google.dev/gemini-api/docs/models
# periódicamente: esta familia cambia con frecuencia.
# Modelo rápido/barato: extracción, OCR de páginas, tareas de volumen.
GEMINI_MODEL_FLASH=gemini-3.6-flash
# Modelo de mayor razonamiento: síntesis de respuestas, comparaciones complejas.
# (a agosto 2026: gemini-2.5-pro ya no está disponible para keys nuevas, y
# Gemini 3 aún no tiene un "pro" estable fuera de preview -- por ahora se
# usa el mismo flash. Revisar periódicamente y cambiar en cuanto haya un
# tier pro estable disponible para esta key.)
GEMINI_MODEL_PRO=gemini-3.6-flash
# Modelo de embeddings.
GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# Groq — https://console.groq.com/keys
# Respaldo de ÚLTIMO recurso, solo para generar la respuesta del chat
# (texto), cuando TODAS las keys de Google están agotadas. Groq no
# ofrece modelos de embeddings ni comprensión nativa de PDF -- no puede
# reemplazar la ingesta (OCR/embeddings), solo la generación de
# respuestas del chat sobre contexto ya recuperado.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
