VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Contraseña de entrada a la aplicación. SIN el prefijo VITE_ a propósito: lo
# que empieza por VITE_ acaba dentro del paquete que se descarga el navegador,
# y una contraseña ahí se lee abriendo el código de la página. Ésta la
# comprueba /api/entrar en el servidor y nunca sale de él.
#
# Mientras esté vacía, la aplicación se abre sin pedir nada.
#
# Se pide en cada entrada y en cada recarga: no se guarda ninguna sesión.
#
# Ojo con lo que esto protege: es una puerta, no una cerradura. Todo el código
# va al navegador, con la clave anónima de Supabase dentro. Para cerrar de
# verdad: protección de despliegue en Vercel, o autenticación de Supabase con
# políticas por usuario.
APP_PASSWORD=
